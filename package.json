{
  "name": "krishimitraaz",
  "version": "1.0.0",
  "description": "Smart Crop Advisory System for small & marginal farmers. AI-powered, voice-ready advisory engine.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:frontend": "npm run build --prefix frontend && cp -r frontend/dist dist 2>/dev/null || true",
    "build": "npm run build:frontend",
    "dev": "node src/server.js",
    "lint": "npm run lint --prefix frontend",
    "seed": "node src/db/seed.js",
    "test": "node --test test/engine.test.js"
  },
  "workspaces": [
    "frontend"
  ],
  "keywords": [
    "agriculture",
    "advisory",
    "farmers",
    "crop-advisory",
    "krishimitraaz"
  ],
  "author": "KrishiMitraaz",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  }
}
